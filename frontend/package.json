{
  "name": "@procrastinator-tracker/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && pnpm build:css",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist-lib/styles.css --minify && printf 'declare const styles: string;\\nexport default styles;\\n' > ./dist-lib/styles.d.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": {
      "types": "./dist-lib/styles.d.ts",
      "default": "./dist-lib/styles.css"
    }
  },
  "files": [
    "dist-lib"
  ],
  "typesVersions": {
    "*": {
      "styles.css": [
        "./dist-lib/styles.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "lucide-react": "^0.469.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.469.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^3.0.0"
  }
}
